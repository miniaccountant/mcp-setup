{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "app.miniaccountant/mini-accountant",
  "title": "Mini Accountant",
  "description": "Invoicing, expenses, accounting analytics. OAuth 2.1 dynamic client registration, no API key.",
  "version": "1.0.1",
  "websiteUrl": "https://ad.miniaccountant.app",
  "icons": [
    {
      "src": "https://miniaccountant.app/icons/Icon-512.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    },
    {
      "src": "https://miniaccountant.app/icons/Icon-192.png",
      "mimeType": "image/png",
      "sizes": ["192x192"]
    }
  ],
  "repository": {
    "url": "https://github.com/miniaccountant/mcp-setup",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.miniaccountant.app/v1beta"
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "authentication": {
        "required": true,
        "type": "oauth2.1",
        "flow": "authorization_code+pkce",
        "dynamicClientRegistration": true,
        "apiKeyRequired": false,
        "note": "User-scoped. Clients discover the endpoints via /.well-known/oauth-protected-resource; there is no API key and no anonymous access."
      }
    }
  }
}
